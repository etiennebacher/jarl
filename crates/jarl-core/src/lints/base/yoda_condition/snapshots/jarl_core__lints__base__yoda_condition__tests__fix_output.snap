---
OLD:
====
1 == total
'a' != name
10L < quantity
2 <= length(x)
3 > value
4 >= value
NEW:
====
total == 1
name != 'a'
quantity > 10L
length(x) >= 2
value < 3
value <= 4

OLD:
====
if (1 == x) foo()
while (0 < remaining) remaining <- remaining - 1
NEW:
====
if (x == 1) foo()
while (remaining > 0) remaining <- remaining - 1

