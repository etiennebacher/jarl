{
	"name": "jarl-vscode",
	"displayName": "Jarl",
	"description": "Just Another R Linter",
	"version": "0.0.14",
	"publisher": "etiennebacher",
	"license": "MIT",
	"homepage": "https://github.com/etiennebacher/jarl",
	"repository": {
		"type": "git",
		"url": "https://github.com/etiennebacher/jarl.git"
	},
	"bugs": {
		"url": "https://github.com/etiennebacher/jarl/issues"
	},
	"keywords": [
		"r",
		"linter",
		"diagnostics"
	],
	"engines": {
		"vscode": "^1.91.0"
	},
	"categories": [
		"Linters",
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:r",
		"onLanguage:rmd",
		"onLanguage:quarto",
		"workspaceContains:*.r",
		"workspaceContains:*.R",
		"workspaceContains:*.Rmd",
		"workspaceContains:*.rmd",
		"workspaceContains:*.qmd",
		"workspaceContains:jarl.toml",
		"workspaceContains:.jarl.toml",
		"workspaceContains:DESCRIPTION",
		"workspaceContains:*.Rproj"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "r",
				"extensions": [
					".R",
					".r",
					".Rprofile",
					".rprofile"
				],
				"aliases": [
					"R",
					"r"
				],
				"filenames": [
					"NAMESPACE"
				]
			}
		],
		"configuration": {
			"properties": {
				"jarl.logLevel": {
					"default": null,
					"markdownDescription": "Controls the log level of the language server.",
					"enum": [
						"error",
						"warning",
						"info",
						"debug",
						"trace"
					],
					"scope": "application",
					"type": "string"
				},
				"jarl.dependencyLogLevels": {
					"default": null,
					"markdownDescription": "Controls the log level of the Rust crates that the language server depends on.",
					"scope": "application",
					"type": "string"
				},
				"jarl.executableStrategy": {
					"default": "bundled",
					"markdownDescription": "Strategy used to locate the `jarl` executable to start the language server with.",
					"enum": [
						"bundled",
						"environment",
						"path"
					],
					"enumDescriptions": [
						"Always use the bundled `jarl` executable.",
						"Look for a `jarl` executable using the `PATH` environment variable, falling back to the bundled version.",
						"Look for a `jarl` executable at the fixed path provided by `jarl.executablePath`."
					],
					"scope": "window",
					"type": "string"
				},
				"jarl.executablePath": {
					"default": null,
					"markdownDescription": "The path to a `jarl` executable. Only utilized when `jarl.executableStrategy` is set to \"path\".",
					"scope": "window",
					"type": "string"
				}
			}
		},
		"commands": [
			{
				"title": "Restart Server",
				"category": "Jarl",
				"command": "jarl.restart"
			}
		]
	},
	"scripts": {
		"compile": "npm run check-types && node esbuild.js",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.js --production",
		"vsce:package": "vsce package",
		"pretest": "npm run compile && npm run lint",
		"lint": "biome check",
		"format": "biome check --write --linter-enabled=false",
		"test": "vscode-test"
	},
	"dependencies": {
		"fs-extra": "^11.4.1",
		"p-queue": "^9.3.5",
		"vscode-languageclient": "^11.0.0",
		"which": "^7.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/fs-extra": "^11.0.4",
		"@types/mocha": "^10.0.9",
		"@types/node": "20.x",
		"@types/vscode": "~1.91.0",
		"@types/which": "^3.0.4",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"npm-run-all": "^4.1.5",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"minimatch": "^11.0.1",
		"serialize-javascript": "^7.1.3"
	}
}
